{
  "redirects": [
    {
      "source": "/(creator-portal|creator|marketplace)",
      "destination": "https://www.atmosvibe.io/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "vibe-audit-engine.vercel.app"
        }
      ],
      "destination": "https://www.atmosvibe.io/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/vibe-insights", "destination": "/vibe-insights/index.html" },
    { "source": "/vibe-insights/london-boutique-ota-gap", "destination": "/vibe-insights/london-boutique-ota-gap/index.html" },
    { "source": "/research/london-boutique-ota-gap", "destination": "/vibe-insights/london-boutique-ota-gap/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "vibe-audit-engine.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ]
    },
    {
      "source": "/(creator-portal|creator|marketplace|barcelona|vibe-api|ignore-me|notrack)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version" }
      ]
    }
  ]
}
